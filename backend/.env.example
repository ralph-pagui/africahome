# AfricaHome Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas - Create free cluster at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/africahome?retryWrites=true&w=majority

# JWT Secret - IMPORTANT: Generate a strong random secret (min 64 chars)
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOM_BYTES

# Cloudinary - Create free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Flutterwave - Create account at https://flutterwave.com
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxx
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxx
FLW_ENCRYPTION_KEY=FLWSECK_TESTxxxxxxxxxxxxx
FLW_WEBHOOK_HASH=your_webhook_hash

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# KPay API
KPAY_API_KEY=your_kpay_api_key
KPAY_SECRET_KEY=your_kpay_secret_key
BACKEND_URL=http://localhost:5000

